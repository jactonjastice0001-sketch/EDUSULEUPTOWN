# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separate multiple origins if needed, e.g. for a Render preview URL + custom domain:
# FRONTEND_ORIGIN=https://uptown.onrender.com,https://uptown-yourname.com
FRONTEND_ORIGIN=http://localhost:5173

# ── Storage paths ───────────────────────────────────────
# Leave blank for local dev (defaults to backend/data and backend/uploads).
# On Render, point these at your mounted persistent disk, e.g.:
#   DATA_DIR=/data/db
#   UPLOADS_ROOT=/data/uploads
# Without a persistent disk, uploaded photos and order/user data are wiped
# on every deploy and every restart — fine for testing, not for real launch.
DATA_DIR=
UPLOADS_ROOT=

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=b9dada59330d39f6f108fee1de7d86ff2101fd15eb52b63ab6b7e0f8e1dcb4c33cadeac5a206912a45e6181728eab956
JWT_EXPIRES_IN=7d

# AES-256-GCM key for encrypting ID numbers at rest — must be exactly 32 bytes (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_ENCRYPTION_KEY=f372a07d2009201d73b9289d6e56e4c0ebb8f5fcc0a613ab4c12b291076aa8c3

# ── Daraja (M-Pesa) — Safaricom Sandbox ────────────────
# Get sandbox credentials free at https://developer.safaricom.co.ke
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=your_sandbox_consumer_secret
# Safaricom's public sandbox test shortcode + passkey (safe to commit, these are public test values)
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Must be a publicly reachable HTTPS URL (use ngrok in local dev) — Safaricom calls this after payment
DARAJA_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/orders/mpesa/callback

# ── Admin account ───────────────────────────────────────
# Auto-created on first boot if no admin exists yet. Log in with these at
# the normal /login page — you'll see an "Admin" link once logged in.
ADMIN_FULL_NAME=Edward Sule 
ADMIN_EMAIL=jactonjastice0001@gmail.com
ADMIN_PHONE=0796978358
ADMIN_PASSWORD=43kuptown
# Phone number customers reach via the "Call the kitchen" button (tel: link).
# Can be the same as ADMIN_PHONE or a separate kitchen line.
ADMIN_CALL_NUMBER=0711136309

# ── WhatsApp ────────────────────────────────────────────
# Number that receives orders via wa.me deep link, digits only, country code, no +
WHATSAPP_VENDOR_NUMBER=254711136309
# Optional: WhatsApp Cloud API (Meta) for automated confirmation messages — leave blank to skip
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
