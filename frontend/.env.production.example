# Used only for production builds where the frontend and backend are deployed
# to different origins (e.g. two separate Render services).
#
# Leave this file unused for local dev — Vite's dev server proxy in
# vite.config.js handles /api and /uploads automatically when this isn't set.
#
# For Render: set this as an environment variable on the frontend Static Site
# (not committed here) to your backend's public URL, no trailing slash:
VITE_API_BASE_URL=https://your-backend-service.onrender.com
